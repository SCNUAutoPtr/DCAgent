# Copy to .env (real data) and .env.test (tests, database name must end with _test).
# Every key is required; the server refuses to start without it.
DATABASE_URL="postgresql://dcagent:CHANGE_ME@localhost:5432/dcagent?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ONLINE_STALE_MINUTES=15
# Optional
# LEGACY_DATABASE_URL="postgresql://dcagent:CHANGE_ME@localhost:5432/dcagent_legacy?schema=public"
# SHADOW_DATABASE_URL="postgresql://dcagent:CHANGE_ME@localhost:5432/dcagent_shadow?schema=public"
# OBS_DEFAULT_SAMPLING_RATES="192.0.2.12=1024"

// DCAgent schema (0001_baseline, 2026-10-25).
// Rules that Prisma cannot model (CHECK, EXCLUDE, triggers) live at the end of
// prisma/migrations/0001_baseline/migration.sql under "-- native constraints".
// Derived state (port occupancy, cable stock/in-use, workstation online) is never stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Hierarchy
// ---------------------------------------------------------------------------

model DataCenter {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id           String        @id @default(uuid())
  name         String
  floor        String?
  notes        String?
  dataCenterId String
  dataCenter   DataCenter    @relation(fields: [dataCenterId], references: [id], onDelete: Restrict)
  widthM       Float?
  depthM       Float?
  label        Label?
  cabinets     Cabinet[]
  devices      Device[]
  workstations Workstation[]
  ipSubnets    IpSubnet[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([dataCenterId, name])
}

model Cabinet {
  id           String   @id @default(uuid())
  name         String
  positionCode String?
  heightU      Int      @default(42)
  notes        String?
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  // floor plan / 3D: room coordinates in metres, (fpX,fpY) = front-left corner
  fpX          Float?
  fpY          Float?
  fpW          Float?
  fpD          Float?
  fpRotation   Int      @default(0)
  label        Label?
  devices      Device[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roomId, name])
}

enum DeviceType {
  SERVER
  SWITCH
  ROUTER
  FIREWALL
  STORAGE
  PDU
  OTHER
}

model DeviceModel {
  id         String          @id @default(uuid())
  vendor     String          @default("")
  name       String
  deviceType DeviceType
  /// null = height not known (yet)
  uHeight    Int?
  depthMm    Int?
  notes      String?
  devices    Device[]
  templates  PanelTemplate[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([vendor, name])
}

model Device {
  id            String            @id @default(uuid())
  name          String
  type          DeviceType
  deviceModelId String?
  deviceModel   DeviceModel?      @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  serialNo      String?           @unique
  sysname       String?           @unique
  cabinetId     String?
  cabinet       Cabinet?          @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  roomId        String?
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  uPosition     Int?
  /// null = height not known; a racked device of unknown height occupies at least its uPosition (see device_u_overlap)
  uHeight       Int?
  notes         String?
  panels        Panel[]
  ipAddresses   IpAddress[]
  observations  PortObservation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([cabinetId, name])
  @@unique([roomId, name])
}

// ---------------------------------------------------------------------------
// Panels, ports, templates
// ---------------------------------------------------------------------------

enum PanelType {
  NETWORK
  POWER
  CONSOLE
  USB
  OTHER
}

enum PanelFace {
  FRONT
  REAR
}

enum PortType {
  RJ45
  SFP
  SFP_PLUS
  SFP28
  QSFP
  QSFP28
  QSFP_DD
  CONSOLE
  USB
  POWER
  OTHER
}

enum PortAdminState {
  NORMAL
  RESERVED
  FAULTY
}

model Panel {
  id               String          @id @default(uuid())
  name             String
  type             PanelType
  face             PanelFace       @default(FRONT)
  notes            String?
  deviceId         String
  device           Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  templateId       String?
  template         PanelTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateRevision Int?
  widthMm          Float?
  heightMm         Float?
  label            Label?
  ports            Port[]
  parkedEndpoints  CableEndpoint[] @relation("ParkedOnPanel")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([deviceId, name])
}

model Port {
  id                   String            @id @default(uuid())
  panelId              String
  panel                Panel             @relation(fields: [panelId], references: [id], onDelete: Cascade)
  number               String
  sortIndex            Int
  ifName               String?
  portType             PortType
  label                String?
  adminState           PortAdminState    @default(NORMAL)
  notes                String?
  xMm                  Float?
  yMm                  Float?
  wMm                  Float?
  hMm                  Float?
  rotation             Int               @default(0)
  cableEndpoint        CableEndpoint?
  opticalModule        OpticalModule?
  ipAddress            IpAddress?
  attachedWorkstations Workstation[]
  observations         PortObservation[]
  movementsFrom        ModuleMovement[]  @relation("MovementFrom")
  movementsTo          ModuleMovement[]  @relation("MovementTo")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([panelId, number])
  @@unique([panelId, ifName])
  @@index([panelId, sortIndex])
}

model PanelTemplate {
  id            String              @id @default(uuid())
  name          String              @unique
  type          PanelType
  face          PanelFace           @default(FRONT)
  deviceModelId String?
  deviceModel   DeviceModel?        @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)
  widthMm       Float               @default(482.6)
  heightMm      Float               @default(44.45)
  generator     Json?
  revision      Int                 @default(1)
  description   String?
  ports         PanelTemplatePort[]
  panels        Panel[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model PanelTemplatePort {
  id         String        @id @default(uuid())
  templateId String
  template   PanelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  number     String
  sortIndex  Int
  portType   PortType
  ifName     String?
  xMm        Float
  yMm        Float
  wMm        Float
  hMm        Float
  rotation   Int           @default(0)

  @@unique([templateId, number])
}

// ---------------------------------------------------------------------------
// Cables
// ---------------------------------------------------------------------------

enum CableMedium {
  CAT5E
  CAT6
  CAT6A
  CAT7
  FIBER_SM
  FIBER_MM
  DAC
  AOC
  POWER
  OTHER
}

enum ConnectorType {
  RJ45
  LC
  SC
  MPO
  SFP
  SFP_PLUS
  QSFP
  QSFP28
  OTHER
}

enum CableEnd {
  A
  B
}

model Cable {
  id        String          @id @default(uuid())
  medium    CableMedium
  label     String?
  lengthM   Float?
  color     String?
  notes     String?
  endpoints CableEndpoint[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CableEndpoint {
  id            String         @id @default(uuid())
  cableId       String
  cable         Cable          @relation(fields: [cableId], references: [id], onDelete: Cascade)
  end           CableEnd
  connector     ConnectorType?
  portId        String?        @unique
  port          Port?          @relation(fields: [portId], references: [id], onDelete: SetNull)
  parkedPanelId String?
  parkedPanel   Panel?         @relation("ParkedOnPanel", fields: [parkedPanelId], references: [id], onDelete: SetNull)
  label         Label?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([cableId, end])
  @@index([parkedPanelId])
}

// ---------------------------------------------------------------------------
// Labels (shortID). The only place a shortID lives.
// ---------------------------------------------------------------------------

enum LabelState {
  GENERATED
  PRINTED
  VOID
}

model Label {
  shortId         Int            @id
  state           LabelState     @default(GENERATED)
  printTaskId     String?
  printTask       PrintTask?     @relation(fields: [printTaskId], references: [id], onDelete: SetNull)
  printedAt       DateTime?
  batchNo         String?
  notes           String?
  firstBoundAt    DateTime?
  boundAt         DateTime?
  roomId          String?        @unique
  room            Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  cabinetId       String?        @unique
  cabinet         Cabinet?       @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  panelId         String?        @unique
  panel           Panel?         @relation(fields: [panelId], references: [id], onDelete: SetNull)
  cableEndpointId String?        @unique
  cableEndpoint   CableEndpoint? @relation(fields: [cableEndpointId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([state])
}

enum PrintTaskStatus {
  PENDING
  COMPLETED
  FAILED
}

model PrintTask {
  id          String          @id @default(uuid())
  name        String
  status      PrintTaskStatus @default(PENDING)
  notes       String?
  createdBy   String?
  labels      Label[]
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  updatedAt   DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Optical modules
// ---------------------------------------------------------------------------

enum ModuleStatus {
  IN_STOCK
  INSTALLED
  RESERVED
  FAULTY
  SCRAPPED
}

enum TransceiverForm {
  SFP
  SFP_PLUS
  SFP28
  QSFP
  QSFP28
  QSFP_DD
  OTHER
}

enum MovementType {
  PURCHASE
  INSTALL
  UNINSTALL
  TRANSFER
  REPAIR
  RETURN
  SCRAP
}

model OpticalModule {
  id             String           @id @default(uuid())
  serialNo       String           @unique
  model          String
  vendor         String
  moduleType     TransceiverForm
  wavelength     String?
  distance       String?
  ddmSupport     Boolean          @default(false)
  supplier       String?
  purchaseDate   DateTime?
  price          Float?
  warrantyExpiry DateTime?
  status         ModuleStatus     @default(IN_STOCK)
  currentPortId  String?          @unique
  currentPort    Port?            @relation(fields: [currentPortId], references: [id], onDelete: Restrict)
  movements      ModuleMovement[]
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([moduleType])
}

model ModuleMovement {
  id           String        @id @default(uuid())
  moduleId     String
  module       OpticalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  movementType MovementType
  fromPortId   String?
  fromPort     Port?         @relation("MovementFrom", fields: [fromPortId], references: [id], onDelete: SetNull)
  /// "device / panel / port" at the time of the movement; survives deleting or renaming the port
  fromPortPath String?
  toPortId     String?
  toPort       Port?         @relation("MovementTo", fields: [toPortId], references: [id], onDelete: SetNull)
  toPortPath   String?
  operator     String?
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([moduleId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// IP management. A free address has no row.
// ---------------------------------------------------------------------------

enum IpStatus {
  ALLOCATED
  RESERVED
  BLOCKED
}

// network holds the network address (host form) and prefixLen the mask: Prisma drops the
// prefix of inet values on read and cannot write them, so the mask lives in its own column.
// SQL uses set_masklen("network", "prefixLen") for containment.
model IpSubnet {
  id          String      @id @default(uuid())
  name        String
  network     String      @db.Inet
  prefixLen   Int
  gateway     String?     @db.Inet
  vlan        Int?
  dnsServers  String[]    @default([])
  description String?
  roomId      String?
  room        Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ipAddresses IpAddress[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([network, prefixLen])
  @@index([roomId])
}

model IpAddress {
  id            String       @id @default(uuid())
  subnetId      String
  subnet        IpSubnet     @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  address       String       @db.Inet
  status        IpStatus     @default(ALLOCATED)
  portId        String?      @unique
  port          Port?        @relation(fields: [portId], references: [id], onDelete: SetNull)
  deviceId      String?
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  workstationId String?      @unique
  workstation   Workstation? @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  hostname      String?
  macAddress    String?
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([subnetId, address])
  @@index([status])
  @@index([deviceId])
}

// ---------------------------------------------------------------------------
// Workstations and observability
// ---------------------------------------------------------------------------

enum WorkstationAdminState {
  ACTIVE
  MAINTENANCE
  FAULTY
  RETIRED
}

model Workstation {
  id             String                 @id @default(uuid())
  name           String
  code           String?                @unique
  roomId         String
  room           Room                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  cpu            String?
  memory         String?
  storage        String?
  gpu            String?
  os             String?
  adminState     WorkstationAdminState  @default(ACTIVE)
  assignedTo     String?
  fpX            Float?
  fpY            Float?
  fpW            Float?
  fpD            Float?
  notes          String?
  attachedPortId String?
  attachedPort   Port?                  @relation(fields: [attachedPortId], references: [id], onDelete: SetNull)
  lastSeenAt     DateTime?
  lastCheckedAt  DateTime?
  ipAddress      IpAddress?
  unmatched      ObservationUnmatched[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([roomId, name])
  @@index([attachedPortId])
}

model PortObservation {
  id             String   @id @default(uuid())
  deviceId       String
  /// history is never dropped implicitly: deleting a device with observations needs force (service deletes them explicitly)
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  portId         String?
  port           Port?    @relation(fields: [portId], references: [id], onDelete: SetNull)
  ifName         String
  phy            String?
  inUtilPercent  Float?
  outUtilPercent Float?
  inErrors       Int?
  outErrors      Int?
  rxPowerDbm     Float?
  txPowerDbm     Float?
  rxLowAlarmDbm  Float?
  rxLowWarnDbm   Float?
  collectedAt    DateTime @default(now())

  @@index([deviceId, ifName, collectedAt])
  @@index([portId])
}

enum UnmatchedSource {
  WORKSTATION_ATTACH
  PORT_OBSERVATION
}

model ObservationUnmatched {
  id            String          @id @default(uuid())
  source        UnmatchedSource
  sysname       String
  ifName        String?
  workstationId String?
  workstation   Workstation?    @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  payload       Json
  createdAt     DateTime        @default(now())

  @@index([source])
}

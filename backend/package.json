{
  "name": "dcagent-backend",
  "version": "0.1.0",
  "description": "DCAgent backend - data center cable and asset management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && node scripts/check-no-emoji.mjs && node scripts/check-public-safe.mjs",
    "check:public": "node scripts/check-public-safe.mjs",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:int": "npm run db:test:reset && NODE_ENV=test node --import tsx --test --test-concurrency=1 \"test/**/*.int.test.ts\"",
    "db:deploy": "prisma migrate deploy",
    "db:test:reset": "tsx scripts/db-test-reset.ts",
    "db:legacy:restore": "bash scripts/restore-legacy.sh",
    "migrate:legacy": "tsx scripts/migrate-from-legacy.ts",
    "templates:presets": "tsx scripts/import-template-presets.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "datacenter",
    "cable-management",
    "asset-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "nodemon": "^3.1.10",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
